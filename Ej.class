 #include <iostream>
#include <initializer_list>
using namespace std;

class ListaEnlazada {
private:
    struct Nodo {
        int dato;
        Nodo* sig;
    };
    Nodo* cabeza;

    static Nodo* invertir(Nodo* p) {
        Nodo* previo = nullptr;
        while (p) {
            Nodo* siguiente = p->sig;
            p->sig = previo;
            previo = p;
            p = siguiente;
        }
        return previo;
    }

public:
    ListaEnlazada() : cabeza(nullptr) {}  //2

    ListaEnlazada(const ListaEnlazada&) = delete;
    ListaEnlazada& operator=(const ListaEnlazada&) = delete;

    ~ListaEnlazada() {
        while (cabeza) {
            Nodo* a = cabeza;
            cabeza = cabeza->sig;
            delete a;
        }
    }

    void agregar(int x) {                             //3
        Nodo* nuevo = new Nodo{x, nullptr};
        if (!cabeza) { cabeza = nuevo; return; }
        Nodo* p = cabeza;
        while (p->sig) p = p->sig;
        p->sig = nuevo;
    }

    bool esPalindromo() {                             //5
        if (!cabeza || !cabeza->sig) return true;  

        Nodo* lento = cabeza;
        Nodo* rapido = cabeza;
        while (rapido->sig && rapido->sig->sig) {
            lento = lento->sig;
            rapido = rapido->sig->sig;
        }                                            //5

        Nodo* segunda = invertir(lento->sig);
        Nodo* colaInvertida = segunda;              

        Nodo* primera = cabeza;
        bool igual = true;
        while (segunda) {
            if (primera->dato != segunda->dato) igual = false;
            primera = primera->sig;
            segunda = segunda->sig;
        }

        lento->sig = invertir(colaInvertida);
        return igual;
    }

    void imprimir() const {                              //4
        if (!cabeza) { cout << "(vacia)"; return; }
        for (Nodo* p = cabeza; p; p = p->sig)
            cout << p->dato << (p->sig ? " -> " : "");
    }
};

void probar(initializer_list<int> datos) {      //2
    ListaEnlazada l;                            //2
    for (int x : datos) l.agregar(x);           //3

    cout << "Antes:   ";
    l.imprimir();                               //4
    cout << "\nResultado: " << (l.esPalindromo() ? "Es palindromo" : "No es palindromo");  //5
    cout << "\nDespues: ";
    l.imprimir();
    cout << "\n\n";
}

int main() {                               //1
    probar({1, 2, 3, 2, 1});
    probar({1, 2, 2, 1});
    probar({1, 2, 3, 4});
    probar({7});
    probar({});
    return 0;
}
